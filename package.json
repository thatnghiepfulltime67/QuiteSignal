{
  "name": "quitesignal",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "workspaces": [
    "apps/*",
    "services/*",
    "modules/*"
  ],
  "scripts": {
    "doctor": "tsx ops/scripts/doctor.mts",
    "format:check": "prettier --check package.json package-lock.json tsconfig.base.json prettier.config.mjs ops evidence modules services",
    "format:write": "prettier --write package.json package-lock.json tsconfig.base.json prettier.config.mjs ops evidence modules services",
    "lint": "npm run format:check && npm run typecheck",
    "typecheck": "tsc --noEmit --project tsconfig.base.json",
    "compile": "npm run --workspace @quitesignal/protocol compile && npm run typecheck",
    "test:unit": "node --test --test-reporter=spec",
    "test:interfaces": "npm run --workspace @quitesignal/protocol test:interfaces",
    "test:verifier": "npm run --workspace @quitesignal/verifier test",
    "test:sdk": "npm run --workspace @quitesignal/confidential-client test",
    "test:automation": "npm run --workspace @quitesignal/automation test",
    "test:indexer": "npm run --workspace @quitesignal/indexer test",
    "dev:web": "npm run --workspace @quitesignal/web dev --",
    "build:web": "npm run --workspace @quitesignal/web build",
    "test:web": "npm run --workspace @quitesignal/web test",
    "rebuild:indexer:sepolia": "tsx services/indexer/scripts/rebuild-sepolia.mts",
    "run:live:sepolia": "npm run --workspace @quitesignal/protocol run:live:sepolia --",
    "run:recovery:sepolia": "npm run --workspace @quitesignal/protocol run:recovery:sepolia --",
    "run:automation-fixture:sepolia": "npm run --workspace @quitesignal/protocol run:automation-fixture:sepolia --",
    "run:automation:sepolia": "npm run --workspace @quitesignal/automation run:sepolia --",
    "verify:automation:sepolia": "npm run --workspace @quitesignal/automation verify:sepolia",
    "test:sdk:nox:sepolia": "npm run --workspace @quitesignal/confidential-client test:nox:sepolia --",
    "test:sdk:commit-client:sepolia": "npm run --workspace @quitesignal/confidential-client test:transaction:sepolia --",
    "verify:sdk:transaction:sepolia": "npm run --workspace @quitesignal/confidential-client verify:transaction:sepolia --",
    "verify:protocol:sepolia": "npm run --workspace @quitesignal/verifier verify:sepolia --",
    "write:live01:manifest": "npm run --workspace @quitesignal/verifier write:live01:manifest",
    "write:live02:manifests": "npm run --workspace @quitesignal/verifier write:live02:manifests",
    "verify:live02:recovery": "npm run --workspace @quitesignal/verifier verify:live02:recovery",
    "verify:g5:evidence": "npm run --workspace @quitesignal/verifier verify:g5 --",
    "verify:g6:evidence": "npm run --workspace @quitesignal/verifier verify:g6 --",
    "verify:g7:web": "npm run --workspace @quitesignal/verifier verify:g7:web --",
    "test:adapter:sepolia": "npm run --workspace @quitesignal/protocol test:adapter:sepolia --",
    "test:commit:sepolia": "npm run --workspace @quitesignal/protocol test:commit:sepolia --",
    "test:aggregate:sepolia": "npm run --workspace @quitesignal/protocol test:aggregate:sepolia --",
    "test:adversarial:sepolia": "npm run --workspace @quitesignal/protocol test:adversarial:sepolia --",
    "test:resolution:sepolia": "npm run --workspace @quitesignal/protocol test:resolution:sepolia --",
    "test:terminals:sepolia": "npm run --workspace @quitesignal/protocol test:terminals:sepolia --",
    "test:sdk-transaction:sepolia": "npm run --workspace @quitesignal/protocol test:sdk-transaction:sepolia --",
    "verify:terminals:sepolia": "npm run --workspace @quitesignal/protocol verify:terminals:sepolia",
    "verify:resolution:sepolia": "npm run --workspace @quitesignal/protocol verify:resolution:sepolia",
    "test:factory:sepolia": "npm run --workspace @quitesignal/protocol test:factory:sepolia --",
    "deploy:sepolia:plan": "npm run --workspace @quitesignal/protocol deploy:sepolia:plan --",
    "deploy:sepolia:write": "npm run --workspace @quitesignal/protocol deploy:sepolia:write --",
    "test:deployment-plan": "npm run --workspace @quitesignal/protocol test:deployment-plan",
    "test:model": "npm run --workspace @quitesignal/protocol test:model && npm run --workspace @quitesignal/domain test:model",
    "test:nox:sepolia": "npm run --workspace @quitesignal/protocol test:nox:sepolia --",
    "test:g4:resolution:sepolia": "tsx modules/protocol/scripts/feasibility/run-g4-resolution-sepolia.mts",
    "recover:nox:sepolia": "npm run --workspace @quitesignal/protocol recover:nox:sepolia --",
    "budget:status": "tsx ops/scripts/budget-status.mts",
    "assess:g4:sepolia": "tsx ops/scripts/assess-g4-candidates.mts",
    "assess:g4:resolution:sepolia": "tsx ops/scripts/assess-g4-resolution-target.mts",
    "verify:evidence": "tsx ops/scripts/verify-evidence.mts G3",
    "verify:g4:evidence": "tsx ops/scripts/verify-g4-evidence.mts",
    "scan:secrets": "tsx ops/scripts/check-secrets.mts",
    "scan:dependencies": "npm audit --audit-level=critical && tsx ops/scripts/dependency-report.mts",
    "check:offline": "npm run format:check && npm run lint && npm run compile && npm run test:verifier && npm run test:sdk && npm run test:automation && npm run test:indexer && npm run scan:secrets",
    "check:sepolia:read": "npm run doctor && npm run budget:status"
  },
  "devDependencies": {
    "@iexec-nox/handle": "0.1.0-beta.13",
    "@iexec-nox/nox-confidential-contracts": "0.2.2",
    "@iexec-nox/nox-protocol-contracts": "0.2.4",
    "@types/node": "24.13.3",
    "ethers": "6.17.0",
    "hardhat": "3.12.0",
    "prettier": "3.9.6",
    "prettier-plugin-solidity": "2.3.1",
    "tsx": "4.23.1",
    "typescript": "6.0.2",
    "viem": "2.55.10"
  }
}
