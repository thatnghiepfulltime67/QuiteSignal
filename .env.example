# Ethereum Sepolia only. Never use a mainnet-funded or production key.
SEPOLIA_CHAIN_ID=11155111
SEPOLIA_RPC_URL=
SEPOLIA_PRIVATE_KEY=

# Optional deterministic actors for distinct-wallet k-gate scenarios.
SEPOLIA_ACTOR_MNEMONIC=
SEPOLIA_ACTOR_COUNT=4
SEPOLIA_ACTOR_FUNDING_ETH=0.015

# Hard budget. Write scripts must refuse spends beyond these bounds.
SEPOLIA_MAX_TOTAL_SPEND_ETH=0.5
SEPOLIA_MIN_RESERVE_ETH=0.05
SEPOLIA_MAX_SINGLE_TX_ETH=0.05
SEPOLIA_FINALITY_CONFIRMATIONS=3

# Set to yes only after reviewing the dry-run transaction and spend plan.
CONFIRM_SEPOLIA_WRITE=no

# Optional source verification.
ETHERSCAN_API_KEY=
